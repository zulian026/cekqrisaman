---
import Layout from '../layouts/Layout.astro';
---

<Layout>
  <div class="bg-paper text-ink lg:flex lg:mx-auto lg:max-w-[1440px]">
    <!-- ============ SIDEBAR: dark console (SOHub near-black block) ============ -->
    <aside class="bg-dark text-wht lg:sticky lg:top-0 lg:flex lg:h-screen lg:w-[380px] lg:shrink-0 lg:flex-col lg:overflow-y-auto">
      <div class="flex items-center justify-between px-6 pt-6">
        <p class="font-display text-[22px] font-extrabold tracking-tight">CekQRIS<span class="text-teal">Aman</span></p>
        <span class="rounded-full border border-darkline px-3 py-1.5 text-[11px] font-semibold uppercase tracking-wider text-dsoft">100% lokal</span>
      </div>

      <div class="px-6 pb-6 pt-7">
        <p class="text-[11px] font-semibold uppercase tracking-[0.22em] text-dmute">Periksa QRIS</p>

        <button id="btn-camera" type="button" class="mt-4 w-full rounded-full bg-wht px-5 py-3.5 font-semibold text-dark transition hover:bg-white">
          Scan dengan kamera
        </button>
        <label for="file-input" class="mt-2.5 block w-full cursor-pointer rounded-full border border-darkline px-5 py-3.5 text-center font-semibold text-wht transition hover:bg-dark2">
          Upload foto QR
        </label>
        <input id="file-input" type="file" accept="image/*" class="hidden" />

        <div id="camera-wrap" class="mt-3 hidden">
          <video id="camera" playsinline muted autoplay class="aspect-[4/3] w-full rounded-2xl bg-black object-cover"></video>
          <button id="btn-stop-camera" type="button" class="mt-2.5 w-full rounded-full border border-errbadge/40 bg-errbg px-5 py-3 font-semibold text-errbadge">Berhenti memindai</button>
        </div>

        <div id="dropzone" class="mt-3 hidden rounded-2xl border-2 border-dashed border-darkline bg-dinput px-4 py-5 text-center text-sm text-dsoft transition sm:block">
          Tarik foto QR ke sini, atau tempel (paste) gambar dari clipboard.
        </div>

        <details class="mt-5">
          <summary class="cursor-pointer text-sm font-semibold text-dsoft">Tempel teks isi QR</summary>
          <div class="mt-2.5">
            <textarea id="payload-input" rows="3" class="w-full rounded-2xl border border-darkline bg-dinput p-3.5 font-mono text-xs text-wht placeholder:text-dmute" placeholder="000201010211..."></textarea>
            <div class="mt-2.5 flex gap-2">
              <button id="btn-check-payload" type="button" class="flex-1 rounded-full bg-teal px-4 py-2.5 font-bold text-dark transition hover:bg-[#3cc9b6]">Periksa</button>
              <button id="btn-demo" type="button" class="rounded-full border border-darkline px-4 py-2.5 font-semibold text-dsoft transition hover:bg-dark2">Contoh QRIS</button>
            </div>
          </div>
        </details>

        <p id="status" class="mt-4 hidden rounded-2xl px-4 py-3 text-sm" role="status"></p>
      </div>

      <div class="border-t border-darkline px-6 py-5 lg:min-h-0 lg:flex-1">
        <div class="flex items-center justify-between">
          <p class="text-[11px] font-semibold uppercase tracking-[0.22em] text-dmute">Riwayat di perangkat ini</p>
          <button id="btn-clear-history" type="button" class="hidden text-xs font-semibold text-dsoft hover:text-wht hover:underline">Hapus semua</button>
        </div>
        <p id="history-empty" class="mt-3 text-sm leading-relaxed text-dmute">Belum ada pemeriksaan. Hasil scan akan tersimpan di sini, hanya di browser Anda.</p>
        <ul id="history-list" class="mt-2 space-y-1"></ul>
      </div>

      <div class="border-t border-darkline px-6 py-5">
        <p class="text-[11px] font-semibold uppercase tracking-[0.22em] text-dmute">Mode Pedagang</p>
        <div id="ref-empty">
          <p class="mt-3 text-sm leading-relaxed text-dmute">
            Simpan QRIS Anda sendiri sebagai referensi. Setiap pemeriksaan sesudahnya dibandingkan dengan referensi itu —
            stiker yang ditempel orang lain akan langsung ketahuan berbeda.
          </p>
          <p class="mt-2 text-sm leading-relaxed text-dsoft">
            Caranya: periksa QRIS Anda sekali, lalu klik <span class="font-semibold text-wht">Simpan sebagai QRIS saya</span> pada hasil pemeriksaan.
          </p>
        </div>
        <div id="ref-saved" class="hidden">
          <p id="ref-name" class="font-display mt-3 text-lg font-bold leading-snug text-wht"></p>
          <p id="ref-meta" class="mt-0.5 text-xs text-dmute"></p>
          <div class="mt-3 flex flex-wrap gap-2">
            <button id="btn-view-card" type="button" class="rounded-full bg-wht px-4 py-2 text-sm font-semibold text-dark transition hover:bg-white">Kartu verifikasi</button>
            <button id="btn-delete-ref" type="button" class="rounded-full border border-darkline px-4 py-2 text-sm font-semibold text-dsoft transition hover:bg-dark2">Hapus referensi</button>
          </div>
        </div>
      </div>
    </aside>

    <!-- ============ MAIN: porcelain canvas ============ -->
    <main class="min-w-0 flex-1 px-5 py-8 sm:px-8 lg:px-14 lg:py-14">
      <div class="max-w-3xl">
        <section>
          <p class="text-xs font-semibold uppercase tracking-[0.25em] text-teald">Pemeriksa QRIS &middot; Gratis &middot; Tanpa server</p>
          <h1 class="font-display mt-5 text-[2.6rem] font-extrabold leading-[1.0] tracking-tight sm:text-6xl xl:text-7xl">
            Cek isi QRIS,<br /><span class="text-teald">sebelum</span> uang<br />berpindah.
          </h1>
          <p class="mt-6 max-w-xl text-base leading-relaxed text-grey sm:text-lg">
            Stiker QRIS palsu ditempel di atas yang asli sedang marak. Baca isi kode itu sendiri —
            nama penerima, nominal yang terkunci, dan checksum keasliannya — dari panel pemeriksaan.
          </p>
        </section>

        <section id="empty-state" class="mt-12 rounded-3xl border-2 border-dashed border-linel bg-cardw/60 px-6 py-14 text-center">
          <div aria-hidden="true" class="mx-auto grid w-fit grid-cols-3 gap-1.5">
            <span class="h-5 w-5 rounded-[5px] bg-ink"></span><span class="h-5 w-5 rounded-[5px] bg-linel"></span><span class="h-5 w-5 rounded-[5px] bg-ink"></span>
            <span class="h-5 w-5 rounded-[5px] bg-linel"></span><span class="h-5 w-5 rounded-[5px] bg-teal"></span><span class="h-5 w-5 rounded-[5px] bg-linel"></span>
            <span class="h-5 w-5 rounded-[5px] bg-ink"></span><span class="h-5 w-5 rounded-[5px] bg-linel"></span><span class="h-5 w-5 rounded-[5px] bg-ink"></span>
          </div>
          <p class="font-display mt-6 text-2xl font-bold tracking-tight">Belum ada QR yang diperiksa</p>
          <p class="mx-auto mt-2 max-w-md text-sm leading-relaxed text-grey">
            Scan stiker QRIS di meja kasir, upload fotonya, atau tempel teks isi QR.
            Hasil pemeriksaan lengkap akan tampil di area ini.
          </p>
        </section>

        <section id="result" class="mt-12 hidden" aria-label="Hasil pemeriksaan">
          <div id="verdict-banner" class="rounded-3xl p-6 sm:p-8">
            <p id="verdict-title" class="font-display text-3xl font-extrabold tracking-tight sm:text-4xl"></p>
            <p id="verdict-desc" class="mt-2 text-sm leading-relaxed"></p>
            <p class="mt-4 text-xs opacity-80">Skor risiko struktural: <span id="verdict-score" class="font-bold"></span>/100. Skor ini menilai isi kode QR, bukan reputasi penjual.</p>
          </div>

          <div id="compare-banner" class="mt-4 hidden rounded-3xl p-6 sm:p-7">
            <p id="compare-title" class="font-display text-2xl font-extrabold tracking-tight"></p>
            <p id="compare-desc" class="mt-1.5 text-sm leading-relaxed"></p>
            <ul id="compare-diffs" class="mt-3 space-y-1.5 text-sm"></ul>
          </div>

          <div id="merchant-card" class="mt-4 rounded-3xl bg-cardw p-6 shadow-[0_18px_50px_-24px_rgba(12,16,22,0.25)] ring-1 ring-linel sm:p-8">
            <p class="text-[11px] font-semibold uppercase tracking-[0.22em] text-faint">Nama penerima di dalam QR</p>
            <p id="m-name" class="font-display mt-3 text-4xl font-extrabold leading-[1.05] tracking-tight sm:text-5xl"></p>
            <dl id="m-rows" class="mt-6 divide-y divide-linel text-sm"></dl>
            <button id="btn-save-ref" type="button" class="mt-6 w-full rounded-full border border-linel px-5 py-3 font-semibold text-ink transition hover:border-teald hover:text-teald">Simpan sebagai QRIS saya (Mode Pedagang)</button>
          </div>

          <div class="mt-4 rounded-3xl bg-cardw p-6 shadow-[0_18px_50px_-24px_rgba(12,16,22,0.25)] ring-1 ring-linel sm:p-8">
            <p class="text-[11px] font-semibold uppercase tracking-[0.22em] text-faint">Sinyal pemeriksaan</p>
            <ul id="signals" class="mt-5 space-y-4"></ul>
          </div>

          <details class="mt-4 rounded-3xl bg-cardw p-6 shadow-[0_18px_50px_-24px_rgba(12,16,22,0.25)] ring-1 ring-linel sm:p-8">
            <summary class="font-display cursor-pointer text-lg font-bold tracking-tight">Rincian teknis payload</summary>
            <div class="mt-4 overflow-x-auto">
              <table class="w-full text-left font-mono text-xs">
                <thead><tr class="text-faint"><th class="py-1 pr-3">Tag</th><th class="py-1 pr-3">Arti</th><th class="py-1">Nilai</th></tr></thead>
                <tbody id="fields-table"></tbody>
              </table>
            </div>
            <p class="mt-5 text-xs font-semibold uppercase tracking-wider text-faint">Payload mentah</p>
            <pre id="raw-payload" class="mt-1.5 overflow-x-auto whitespace-pre-wrap break-all rounded-2xl bg-paper p-4 font-mono text-xs text-grey ring-1 ring-linel"></pre>
          </details>
        </section>

        <section class="mt-12">
          <p class="text-xs font-semibold uppercase tracking-[0.25em] text-teald">Cara kerja</p>
          <div class="mt-2 divide-y divide-linel border-y border-linel">
            <div class="flex gap-6 py-6">
              <span class="font-display text-4xl font-extrabold leading-none text-teald sm:text-5xl">01</span>
              <div>
                <p class="font-display text-2xl font-bold tracking-tight">Scan atau upload</p>
                <p class="mt-1 text-sm leading-relaxed text-grey">Arahkan kamera ke stiker QRIS, atau upload foto dan tangkapan layarnya.</p>
              </div>
            </div>
            <div class="flex gap-6 py-6">
              <span class="font-display text-4xl font-extrabold leading-none text-teald sm:text-5xl">02</span>
              <div>
                <p class="font-display text-2xl font-bold tracking-tight">Baca nama aslinya</p>
                <p class="mt-1 text-sm leading-relaxed text-grey">Nama penerima dibaca dari dalam kode, bukan dari logo atau tulisan pada stiker.</p>
              </div>
            </div>
            <div class="flex gap-6 py-6">
              <span class="font-display text-4xl font-extrabold leading-none text-teald sm:text-5xl">03</span>
              <div>
                <p class="font-display text-2xl font-bold tracking-tight">Cocokkan, lalu bayar</p>
                <p class="mt-1 text-sm leading-relaxed text-grey">Samakan nama dan nominal dengan yang muncul di aplikasi pembayaran Anda. Beda nama, batalkan.</p>
              </div>
            </div>
          </div>
        </section>

        <section class="mt-14 rounded-3xl bg-dark p-7 text-wht sm:p-10">
          <p class="font-display text-3xl font-extrabold tracking-tight">Foto Anda tidak pernah meninggalkan ponsel</p>
          <p class="mt-3 text-sm leading-relaxed text-dsoft">
            Semua pemrosesan — membaca QR, membongkar payload, memeriksa checksum — terjadi di browser Anda.
            Tidak ada server yang menerima foto, tidak ada pelacakan, tidak ada data yang disimpan.
            Riwayat pemeriksaan pun hanya tersimpan di perangkat ini dan bisa dihapus kapan saja.
            Setelah kunjungan pertama, alat ini bahkan tetap bekerja tanpa internet.
          </p>
          <p class="mt-5 border-t border-darkline pt-5 text-sm leading-relaxed text-dsoft">
            <span class="font-semibold text-wht">Batas alat ini.</span>
            Ia memeriksa struktur dan keutuhan isi QR, bukan reputasi penjual. QR yang sah tetap bisa dipakai orang yang tidak jujur,
            jadi pemeriksaan terakhir tetap di tangan Anda: cocokkan nama penerima di aplikasi pembayaran sebelum memasukkan PIN,
            dan jangan pernah memasukkan PIN atau OTP di halaman web mana pun.
          </p>
        </section>

        <section id="verify-card-section" class="mt-14 hidden">
          <p class="text-xs font-semibold uppercase tracking-[0.25em] text-teald">Kartu verifikasi pedagang</p>
          <div id="verify-card" class="mt-4 rounded-3xl bg-dark p-8 text-wht sm:p-10">
            <p class="text-[11px] font-semibold uppercase tracking-[0.25em] text-teal">QRIS resmi toko ini</p>
            <p id="vc-name" class="font-display mt-3 text-4xl font-extrabold leading-[1.02] tracking-tight sm:text-5xl"></p>
            <p id="vc-city" class="mt-2 text-dsoft"></p>
            <p class="mt-6 border-t border-darkline pt-5 text-sm leading-relaxed text-dsoft">
              Sebelum memasukkan PIN, cocokkan nama penerima yang muncul di aplikasi pembayaran Anda
              dengan nama besar di kartu ini. <span class="font-semibold text-wht">Bila berbeda, jangan bayar</span> —
              kemungkinan stiker QRIS telah ditempel orang lain.
            </p>
            <p class="mt-5 text-xs text-dmute">Referensi tersimpan <span id="vc-date"></span> &middot; Periksa mandiri di cekqrisaman.vercel.app</p>
          </div>
          <button id="btn-print-card" type="button" class="mt-4 rounded-full bg-dark px-6 py-3 font-semibold text-wht transition hover:bg-dark2">Cetak kartu</button>
          <p class="mt-2.5 text-sm text-grey">Cetak dan tempel kartu ini di samping stiker QRIS Anda. Pembeli akan ikut mengawasi nama penerima setiap kali membayar.</p>
        </section>

        <footer class="mt-12 text-xs leading-relaxed text-faint">
          <p class="font-display text-base font-extrabold tracking-tight text-ink">CekQRIS<span class="text-teald">Aman</span></p>
          <p class="mt-1.5">Proyek gratis untuk pembeli dan pedagang Indonesia.</p>
        </footer>
      </div>
    </main>
  </div>

  <script>
    import { assessPayload, compareWithReference, MCC_LABELS, ADDITIONAL_DATA_LABELS, formatIdr, type EmvField, type RiskReport, type Verdict } from '../lib/qris';
    import { decodeBlob, decodeVideoFrame } from '../lib/decode';

    const DEMO_PAYLOAD =
      '00020101021126610014ID.CO.QRIS.WWW01189360091534567890120210ML123456780303UMI5204541153033605802ID5916TOKO BERKAH JAYA6007JAKARTA61051011062200306TOKO010706KASIR16304C352';

    const $ = (id: string) => document.getElementById(id)!;
    const statusEl = $('status');
    const resultEl = $('result');

    function setStatus(text: string, kind: 'info' | 'error' | 'ok') {
      statusEl.textContent = text;
      statusEl.className = 'mt-4 rounded-2xl px-4 py-3 text-sm font-medium ' + (kind === 'error'
        ? 'bg-errbg text-errbadge'
        : kind === 'ok'
          ? 'bg-okbgd text-okbadge'
          : 'bg-infobg text-infotxt');
    }
    function clearStatus() { statusEl.className = 'mt-4 hidden rounded-2xl px-4 py-3 text-sm'; statusEl.textContent = ''; }

    const VERDICTS = {
      SESUAI_STRUKTUR: { title: 'Struktur QRIS valid', desc: 'Isi kode ini utuh dan sesuai standar QRIS. Tetap cocokkan nama penerima di aplikasi pembayaran Anda dengan nama toko sebelum memasukkan PIN.', cls: 'bg-vokbg text-voktxt', titleCls: 'text-voktitle' },
      PERIKSA_LAGI: { title: 'Periksa lagi sebelum membayar', desc: 'Ada bagian isi QR yang tidak lazim. Jangan lanjutkan pembayaran sebelum Anda yakin nama penerima dan nominalnya benar.', cls: 'bg-vwarnbg text-vwarntxt', titleCls: 'text-vwarntitle' },
      BERISIKO_TINGGI: { title: 'Berisiko tinggi — jangan bayar', desc: 'Isi kode ini rusak atau telah diubah dari terbitan aslinya. Minta QR lain kepada penjual, atau bayar dengan cara lain.', cls: 'bg-vbadbg text-vbadtxt', titleCls: 'text-vbadtitle' },
      BUKAN_QRIS: { title: 'Bukan QRIS — pola penipuan quishing', desc: 'Kode ini tidak berisi QRIS pembayaran. Jangan membuka tautannya dan jangan memasukkan data apa pun.', cls: 'bg-vbadbg text-vbadtxt ring-2 ring-vbadtitle/60', titleCls: 'text-vbadtitle' },
    } as const;

    const VERDICT_SHORT: Record<Verdict, string> = {
      SESUAI_STRUKTUR: 'Struktur valid',
      PERIKSA_LAGI: 'Periksa lagi',
      BERISIKO_TINGGI: 'Berisiko tinggi',
      BUKAN_QRIS: 'Bukan QRIS',
    };

    const TAG_LABELS: Record<string, string> = {
      '00': 'Format payload', '01': 'Metode inisiasi (11 statis, 12 dinamis)', '52': 'Kategori merchant (MCC)',
      '53': 'Mata uang', '54': 'Nominal terkunci', '55': 'Indikator tip', '58': 'Negara', '59': 'Nama merchant',
      '60': 'Kota merchant', '61': 'Kode pos', '62': 'Data tambahan', '63': 'Checksum CRC',
    };

    function addRow(dl: HTMLElement, label: string, value?: string) {
      if (!value) return;
      const row = document.createElement('div');
      row.className = 'flex flex-col gap-0.5 py-2.5 sm:flex-row sm:items-baseline sm:justify-between sm:gap-4';
      const dt = document.createElement('dt'); dt.className = 'shrink-0 text-faint'; dt.textContent = label;
      const dd = document.createElement('dd'); dd.className = 'font-semibold text-ink [overflow-wrap:anywhere] sm:text-right'; dd.textContent = value;
      row.append(dt, dd);
      dl.appendChild(row);
    }

    function flattenFields(fields: EmvField[], depth: number, out: Array<[string, string, string]>) {
      for (const f of fields) {
        const indent = '— '.repeat(depth);
        let label = TAG_LABELS[f.tag] ?? (depth > 0 ? (ADDITIONAL_DATA_LABELS[f.tag] ?? 'Sub-field') : 'Template / field');
        if (depth === 0 && Number(f.tag) >= 26 && Number(f.tag) <= 51) label = 'Akun merchant';
        out.push([f.tag, indent + label, f.value]);
        if (f.children) flattenFields(f.children, depth + 1, out);
      }
    }

    function render(report: RiskReport) {
      const v = VERDICTS[report.verdict];
      const banner = $('verdict-banner');
      banner.className = 'rounded-3xl p-6 sm:p-8 ' + v.cls;
      const titleEl = $('verdict-title');
      titleEl.className = 'font-display text-3xl font-extrabold tracking-tight sm:text-4xl ' + v.titleCls;
      titleEl.textContent = v.title;
      $('verdict-desc').textContent = v.desc;
      $('verdict-score').textContent = String(report.score);

      const d = report.data;
      const card = $('merchant-card');
      const rows = $('m-rows');
      rows.replaceChildren();
      if (d) {
        card.classList.remove('hidden');
        $('m-name').textContent = d.merchantName ?? '(nama tidak tercantum di dalam QR)';
        addRow(rows, 'Kota', d.merchantCity);
        addRow(rows, 'Jenis QR', d.isDynamic ? 'Dinamis (dibuat per transaksi)' : 'Statis (stiker / cetakan)');
        if (d.amount) addRow(rows, 'Nominal terkunci', 'Rp' + formatIdr(d.amount));
        addRow(rows, 'Mata uang', d.currencyCode === '360' ? 'Rupiah (IDR)' : d.currencyCode);
        if (d.merchantCategoryCode) addRow(rows, 'Kategori usaha', (MCC_LABELS[d.merchantCategoryCode] ?? 'Kode ' + d.merchantCategoryCode));
        if (d.qrisAccount) {
          addRow(rows, 'Penerbit QRIS', d.qrisAccount.globalId);
          addRow(rows, 'PAN merchant', d.qrisAccount.merchantPan);
          addRow(rows, 'ID merchant', d.qrisAccount.merchantId);
        }
        addRow(rows, 'Checksum CRC', d.crcValue ? (d.crcValid ? d.crcValue + ' — cocok' : d.crcValue + ' — TIDAK cocok') : 'tidak ada');
        for (const [tag, val] of Object.entries(d.additionalData)) {
          addRow(rows, ADDITIONAL_DATA_LABELS[tag] ?? 'Data tambahan ' + tag, val);
        }
      } else {
        card.classList.add('hidden');
      }

      const ul = $('signals');
      ul.replaceChildren();
      const icons = { danger: '✕', warn: '!', ok: '✓', info: 'i' } as const;
      const colors = {
        danger: 'bg-vbadtitle text-white',
        warn: 'bg-vwarntitle text-white',
        ok: 'bg-voktitle text-white',
        info: 'bg-grey text-white',
      } as const;
      for (const s of report.signals) {
        const li = document.createElement('li');
        li.className = 'flex gap-3';
        const badge = document.createElement('span');
        badge.className = 'mt-0.5 flex h-7 w-7 shrink-0 items-center justify-center rounded-full text-xs font-bold ' + colors[s.level];
        badge.textContent = icons[s.level];
        const body = document.createElement('div');
        const t = document.createElement('p'); t.className = 'font-semibold text-ink'; t.textContent = s.title;
        const det = document.createElement('p'); det.className = 'text-sm leading-relaxed text-grey'; det.textContent = s.detail;
        body.append(t, det);
        li.append(badge, body);
        ul.appendChild(li);
      }

      const tbody = $('fields-table');
      tbody.replaceChildren();
      if (d) {
        const flat: Array<[string, string, string]> = [];
        flattenFields(d.fields, 0, flat);
        for (const [tag, label, value] of flat) {
          const tr = document.createElement('tr');
          tr.className = 'border-t border-linel align-top';
          const c1 = document.createElement('td'); c1.className = 'py-1.5 pr-3 text-faint'; c1.textContent = tag;
          const c2 = document.createElement('td'); c2.className = 'py-1.5 pr-3 font-sans text-grey'; c2.textContent = label;
          const c3 = document.createElement('td'); c3.className = 'py-1.5 text-ink break-all'; c3.textContent = value;
          tr.append(c1, c2, c3);
          tbody.appendChild(tr);
        }
        ($('raw-payload') as HTMLElement).textContent = d.raw;
      }
      $('empty-state').classList.add('hidden');
      resultEl.classList.remove('hidden');
      if (window.innerWidth < 1024) resultEl.scrollIntoView({ behavior: 'smooth', block: 'start' });
    }

    /* ---------------- History (localStorage, this device only) ---------------- */
    interface HistoryItem { ts: number; payload: string; name: string; verdict: Verdict }
    const HISTORY_KEY = 'cekqrisaman-history';
    const HISTORY_MAX = 10;

    function loadHistory(): HistoryItem[] {
      try {
        const raw = localStorage.getItem(HISTORY_KEY);
        const arr = raw ? JSON.parse(raw) : [];
        return Array.isArray(arr) ? arr.filter((x) => x && typeof x.payload === 'string') : [];
      } catch { return []; }
    }
    function saveHistory(items: HistoryItem[]) {
      try { localStorage.setItem(HISTORY_KEY, JSON.stringify(items.slice(0, HISTORY_MAX))); } catch { /* storage full/blocked */ }
    }
    function dotClass(verdict: Verdict): string {
      return verdict === 'SESUAI_STRUKTUR' ? 'bg-okbadge' : verdict === 'PERIKSA_LAGI' ? 'bg-dotwarn' : 'bg-errbadge';
    }
    function renderHistory() {
      const items = loadHistory();
      const list = $('history-list');
      list.replaceChildren();
      $('history-empty').classList.toggle('hidden', items.length > 0);
      $('btn-clear-history').classList.toggle('hidden', items.length === 0);
      for (const item of items) {
        const li = document.createElement('li');
        const btn = document.createElement('button');
        btn.type = 'button';
        btn.className = 'flex w-full items-center gap-3 rounded-2xl px-3 py-2.5 text-left transition hover:bg-dark2';
        const dot = document.createElement('span');
        dot.className = 'h-2.5 w-2.5 shrink-0 rounded-full ' + dotClass(item.verdict);
        const body = document.createElement('span');
        body.className = 'min-w-0';
        const name = document.createElement('span');
        name.className = 'block truncate text-sm font-semibold text-wht';
        name.textContent = item.name;
        const sub = document.createElement('span');
        sub.className = 'block text-xs text-dmute';
        sub.textContent = VERDICT_SHORT[item.verdict] + ' · ' + new Date(item.ts).toLocaleString('id-ID', { day: 'numeric', month: 'short', hour: '2-digit', minute: '2-digit' });
        body.append(name, sub);
        btn.append(dot, body);
        btn.addEventListener('click', () => {
          ($('payload-input') as HTMLTextAreaElement).value = item.payload;
          checkPayload(item.payload, false);
        });
        li.appendChild(btn);
        list.appendChild(li);
      }
    }
    function pushHistory(report: RiskReport, payload: string) {
      const name = report.data?.merchantName ?? (report.verdict === 'BUKAN_QRIS' ? 'Bukan QRIS (tautan/teks)' : 'QR tanpa nama merchant');
      const items = loadHistory().filter((x) => x.payload !== payload);
      items.unshift({ ts: Date.now(), payload, name, verdict: report.verdict });
      saveHistory(items);
      renderHistory();
    }
    $('btn-clear-history').addEventListener('click', () => { saveHistory([]); renderHistory(); });
    renderHistory();

    /* ---------------- Mode Pedagang: reference QRIS ---------------- */
    interface StoredReference { payload: string; name: string; city?: string; savedAt: number }
    const REF_KEY = 'cekqrisaman-reference';
    let lastCheckedPayload = '';
    let lastReport: RiskReport | null = null;

    function loadReference(): StoredReference | null {
      try {
        const raw = localStorage.getItem(REF_KEY);
        const obj = raw ? JSON.parse(raw) : null;
        return obj && typeof obj.payload === 'string' && typeof obj.name === 'string' ? obj : null;
      } catch { return null; }
    }
    function saveReference(ref: StoredReference | null) {
      try {
        if (ref) localStorage.setItem(REF_KEY, JSON.stringify(ref));
        else localStorage.removeItem(REF_KEY);
      } catch { /* storage blocked */ }
    }
    function fmtDate(ts: number): string {
      return new Date(ts).toLocaleDateString('id-ID', { day: 'numeric', month: 'long', year: 'numeric' });
    }
    function renderReference() {
      const ref = loadReference();
      $('ref-empty').classList.toggle('hidden', !!ref);
      $('ref-saved').classList.toggle('hidden', !ref);
      $('verify-card-section').classList.toggle('hidden', !ref);
      if (ref) {
        $('ref-name').textContent = ref.name;
        $('ref-meta').textContent = 'Referensi sejak ' + fmtDate(ref.savedAt) + (ref.city ? ' · ' + ref.city : '');
        $('vc-name').textContent = ref.name;
        $('vc-city').textContent = ref.city ?? '';
        $('vc-date').textContent = fmtDate(ref.savedAt);
      }
    }
    function renderCompare(scannedPayload: string) {
      const banner = $('compare-banner');
      const ref = loadReference();
      if (!ref || !scannedPayload) { banner.classList.add('hidden'); return; }
      const cmp = compareWithReference(ref.payload, scannedPayload);
      const diffsEl = $('compare-diffs');
      diffsEl.replaceChildren();
      if (cmp.identical) {
        banner.className = 'mt-4 rounded-3xl p-6 sm:p-7 bg-vokbg text-voktxt';
        $('compare-title').className = 'font-display text-2xl font-extrabold tracking-tight text-voktitle';
        $('compare-title').textContent = 'Cocok — ini QRIS referensi Anda';
        $('compare-desc').textContent = 'Isi QR yang ter-scan sama persis, karakter demi karakter, dengan QRIS yang Anda simpan sebagai referensi. Stiker ini asli milik Anda.';
      } else {
        banner.className = 'mt-4 rounded-3xl p-6 sm:p-7 bg-vbadbg text-vbadtxt ring-2 ring-vbadtitle/60';
        $('compare-title').className = 'font-display text-2xl font-extrabold tracking-tight text-vbadtitle';
        $('compare-title').textContent = 'Tidak cocok — ini bukan QRIS referensi Anda';
        $('compare-desc').textContent = 'Isi QR yang ter-scan berbeda dari referensi "' + ref.name + '". Bila QR ini menempel di toko Anda, stiker Anda kemungkinan telah diganti atau ditimpa orang lain. Perbedaan yang ditemukan:';
        for (const diff of cmp.diffs) {
          const li = document.createElement('li');
          const strong = document.createElement('span');
          strong.className = 'block font-semibold';
          strong.textContent = diff.field;
          const refLine = document.createElement('span');
          refLine.className = 'block [overflow-wrap:anywhere]';
          refLine.textContent = 'Referensi: "' + (diff.reference ?? '—') + '"';
          const scanLine = document.createElement('span');
          scanLine.className = 'block [overflow-wrap:anywhere]';
          scanLine.textContent = 'Ter-scan: "' + (diff.scanned ?? '—') + '"';
          li.append(strong, refLine, scanLine);
          diffsEl.appendChild(li);
        }
        if (cmp.diffs.length === 0) {
          const li = document.createElement('li');
          li.textContent = 'Payload berbeda pada bagian data tambahan, tetapi identitas utama sama. Tetap waspada.';
          diffsEl.appendChild(li);
        }
      }
      banner.classList.remove('hidden');
    }
    $('btn-save-ref').addEventListener('click', () => {
      if (!lastReport?.data || !lastCheckedPayload) return;
      saveReference({
        payload: lastCheckedPayload,
        name: lastReport.data.merchantName ?? 'QRIS tanpa nama',
        city: lastReport.data.merchantCity,
        savedAt: Date.now(),
      });
      renderReference();
      renderCompare(lastCheckedPayload);
      setStatus('QRIS referensi tersimpan. Mulai sekarang setiap pemeriksaan dibandingkan dengannya, dan kartu verifikasi Anda sudah siap di kanvas utama.', 'ok');
    });
    $('btn-delete-ref').addEventListener('click', () => {
      saveReference(null);
      renderReference();
      $('compare-banner').classList.add('hidden');
      setStatus('QRIS referensi dihapus dari perangkat ini.', 'info');
    });
    $('btn-view-card').addEventListener('click', () => {
      $('verify-card-section').scrollIntoView({ behavior: 'smooth', block: 'start' });
    });
    $('btn-print-card').addEventListener('click', () => window.print());
    renderReference();

    function checkPayload(text: string, record = true) {
      clearStatus();
      const report = assessPayload(text);
      lastCheckedPayload = text.trim();
      lastReport = report;
      render(report);
      renderCompare(lastCheckedPayload);
      if (record) pushHistory(report, text.trim());
    }

    async function handleFile(file: File) {
      stopCamera();
      setStatus('Membaca kode QR dari foto…', 'info');
      try {
        const text = await decodeBlob(file);
        if (!text) {
          setStatus('Kode QR tidak terbaca dari foto ini. Coba foto yang lebih terang, lurus, dan memenuhi bingkai — atau tempel teks isi QR secara manual.', 'error');
          return;
        }
        setStatus('Kode QR terbaca. Hasil pemeriksaan tampil di kanvas utama.', 'ok');
        checkPayload(text);
      } catch (err) {
        setStatus('Foto tidak bisa diproses: ' + (err instanceof Error ? err.message : String(err)), 'error');
      }
    }

    // Camera scanning
    let stream: MediaStream | null = null;
    let scanTimer: number | undefined;
    const video = $('camera') as HTMLVideoElement;

    function stopCamera() {
      if (scanTimer) window.clearInterval(scanTimer);
      scanTimer = undefined;
      if (stream) stream.getTracks().forEach((t) => t.stop());
      stream = null;
      $('camera-wrap').classList.add('hidden');
      $('btn-camera').textContent = 'Scan dengan kamera';
    }

    async function startCamera() {
      try {
        stream = await navigator.mediaDevices.getUserMedia({ video: { facingMode: 'environment' }, audio: false });
      } catch {
        setStatus('Kamera tidak bisa diakses. Izinkan akses kamera di browser, atau gunakan upload foto.', 'error');
        return;
      }
      video.srcObject = stream;
      $('camera-wrap').classList.remove('hidden');
      $('btn-camera').textContent = 'Kamera menyala…';
      setStatus('Arahkan kamera ke kode QRIS. Pemindaian berjalan otomatis.', 'info');
      scanTimer = window.setInterval(async () => {
        const text = await decodeVideoFrame(video);
        if (text) {
          stopCamera();
          setStatus('Kode QR terbaca. Hasil pemeriksaan tampil di kanvas utama.', 'ok');
          checkPayload(text);
        }
      }, 450);
    }

    $('btn-camera').addEventListener('click', () => { stream ? stopCamera() : startCamera(); });
    $('btn-stop-camera').addEventListener('click', stopCamera);

    const fileInput = $('file-input') as HTMLInputElement;
    fileInput.addEventListener('change', () => {
      const f = fileInput.files?.[0];
      if (f) handleFile(f);
      fileInput.value = '';
    });

    const dz = $('dropzone');
    dz.addEventListener('dragover', (e) => { e.preventDefault(); dz.classList.add('border-teal'); });
    dz.addEventListener('dragleave', () => dz.classList.remove('border-teal'));
    dz.addEventListener('drop', (e) => {
      e.preventDefault();
      dz.classList.remove('border-teal');
      const f = e.dataTransfer?.files?.[0];
      if (f) handleFile(f);
    });
    document.addEventListener('paste', (e) => {
      const item = Array.from(e.clipboardData?.items ?? []).find((i) => i.type.startsWith('image/'));
      const f = item?.getAsFile();
      if (f) handleFile(f);
    });

    $('btn-check-payload').addEventListener('click', () => {
      const text = ($('payload-input') as HTMLTextAreaElement).value;
      if (text.trim()) checkPayload(text);
      else setStatus('Tempel teks isi QR terlebih dahulu.', 'error');
    });
    $('btn-demo').addEventListener('click', () => {
      ($('payload-input') as HTMLTextAreaElement).value = DEMO_PAYLOAD;
      checkPayload(DEMO_PAYLOAD);
    });
  </script>
</Layout>
